{
  "name": "papersage-web",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:backend": "node scripts/package-backend.cjs",
    "desktop:package": "pnpm run desktop:package:win",
    "desktop:package:win": "pnpm run build && pnpm run desktop:backend && electron-builder --win nsis",
    "desktop:package:mac": "pnpm run build && pnpm run desktop:backend && electron-builder --mac dmg",
    "desktop:package:linux": "pnpm run build && pnpm run desktop:backend && electron-builder --linux AppImage deb",
    "desktop:checksums": "node scripts/write-checksums.cjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "ai": "^7.0.37",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.18.1",
    "lucide-react": "latest",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-markdown": "latest",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "latest",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/router-plugin": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "shadcn": "^4.13.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "build": {
    "appId": "com.papersage.desktop",
    "productName": "PaperSage",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "electron/**", "package.json"],
    "extraResources": [{ "from": ".desktop-backend", "to": "backend" }],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
